# Copiar a .env y completar.  .env NUNCA se commitea.

PORT=8080
RUST_LOG=jobout_core_api=debug,tower_http=debug

# --- Base de datos ---
# En Docker el host es el nombre del servicio: postgres
DATABASE_URL=postgres://jobout:jobout@postgres:5432/jobout

# --- Clerk ---
# https://dashboard.clerk.com  ->  API Keys
CLERK_SECRET_KEY=sk_test_reemplazar
CLERK_JWKS_URL=https://reemplazar.clerk.accounts.dev/.well-known/jwks.json

# --- Cifrado de PII ---
# Dos claves DISTINTAS, 32 bytes en base64: `openssl rand -base64 32`
# Si se filtra una, la otra sigue protegiendo. Ver documentation/security.md
PII_ENCRYPTION_KEY=reemplazar
PII_HASH_KEY=reemplazar

# --- S3 privado ---
S3_BUCKET=jobout-cvs-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=reemplazar
S3_SECRET_ACCESS_KEY=reemplazar

# --- jobout-interview ---
# Secreto compartido para el canal interno. NO es una credencial de base de datos:
# ese servicio no tiene ninguna, y no debe tenerla.
INTERVIEW_SERVICE_URL=http://interview:8000
INTERVIEW_SHARED_SECRET=reemplazar
