# Copiar a .env y completar.  .env NUNCA se commitea.

PORT=8080
RUST_LOG=jobout_core_api=debug,tower_http=debug

# --- Base de datos ---
# En Docker el host es el nombre del servicio: postgres
DATABASE_URL=postgres://jobout:jobout@postgres:5432/jobout

# --- Autenticación (MVP: JWT propio; Clerk queda como camino de escala) ---
# Secreto de firma de los JWT, mínimo 32 bytes: `openssl rand -base64 48`
# Estos valores son SOLO para desarrollo local. En cualquier otro entorno, genera los tuyos.
JWT_SECRET=jobout-dev-only-jwt-secret-change-me-before-any-deploy

# --- Cifrado de PII ---
# Dos claves DISTINTAS, 32 bytes en base64: `openssl rand -base64 32`
# Si se filtra una, la otra sigue protegiendo. Ver documentation/security.md
# Valores falsos de desarrollo local; nunca los uses fuera de tu máquina.
PII_ENCRYPTION_KEY=am9ib3V0LWRldi1vbmx5LWVuY3J5cHRpb24ta2V5LTA=
PII_HASH_KEY=am9ib3V0LWRldi1vbmx5LWhhc2gtaG1hYy1rZXktMDI=

# --- Archivos (CVs) ---
# Directorio privado donde se guardan los archivos en desarrollo (se crea con permisos 0700).
# Antes de salir a usuarios reales hay que usar S3: este almacén no tiene redundancia.
BLOB_DIR=./data/blobs

# --- S3 privado ---
S3_BUCKET=jobout-cvs-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=reemplazar
S3_SECRET_ACCESS_KEY=reemplazar

# --- jobout-interview ---
# Secreto compartido para el canal interno. NO es una credencial de base de datos:
# ese servicio no tiene ninguna, y no debe tenerla.
INTERVIEW_SERVICE_URL=http://interview:8000
INTERVIEW_SHARED_SECRET=reemplazar

# --- Cuota por plan (Fase 3) ---
# Por defecto la cuota mensual de entrevistas está activa. Solo `false` (o `0`) la apaga, para
# desarrollo y pruebas: salta la comprobación, pero el uso se sigue registrando en usage_ledger.
ENFORCE_PLAN_LIMITS=true
